<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>nexus</id>
            <username>admin</username>
            <password>NEXUS_PASSWORD</password>
        </server>
        <server>
            <id>nexus-snapshots</id>
            <username>admin</username>
            <password>NEXUS_PASSWORD</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>nexus</id>
            <repositories>
                <!-- fintrack-common releases hosted on local Nexus -->
                <repository>
                    <id>nexus</id>
                    <name>FinTrack — Nexus Releases</name>
                    <url>http://localhost:8081/repository/fintrack/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <!-- Snapshot builds during active development -->
                <repository>
                    <id>nexus-snapshots</id>
                    <name>FinTrack — Nexus Snapshots</name>
                    <url>http://localhost:8081/repository/fintrack-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
                <!-- Maven Central proxied through Nexus -->
                <!-- All external dependencies flow through your local cache -->
                <repository>
                    <id>nexus-central</id>
                    <name>Maven Central via Nexus Proxy</name>
                    <url>http://localhost:8081/repository/maven-central/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>

            <pluginRepositories>
                <!-- Maven plugins also resolved through local Nexus -->
                <pluginRepository>
                    <id>nexus-central</id>
                    <name>Maven Central via Nexus Proxy</name>
                    <url>http://localhost:8081/repository/maven-central/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

